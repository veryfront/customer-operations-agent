{
  "name": "customer-operations-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "veryfront dev",
    "build": "veryfront build",
    "preview": "veryfront serve",
    "routes": "veryfront routes",
    "schedules": "veryfront schedules --json",
    "webhooks": "veryfront webhooks --json",
    "check": "npm run build && npm run routes && npm run schedules && npm run webhooks",
    "workflow:run": "veryfront workflow run escalate-ticket --input \"$(cat fixtures/escalate-ticket.json)\"",
    "schedule:run": "veryfront schedule run daily-support-triage --input fixtures/daily-support-triage.json",
    "webhook:run": "veryfront webhook run customer-escalation --payload fixtures/customer-escalation-webhook.json",
    "eval": "veryfront eval support-triage --json",
    "verify": "npm run check && npm run eval && npm run workflow:run && npm run schedule:run && npm run webhook:run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "veryfront"
    ]
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "veryfront": "^0.1.983"
  }
}
